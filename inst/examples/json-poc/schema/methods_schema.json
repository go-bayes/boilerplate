{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Boilerplate Methods Database Schema",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z_][a-zA-Z0-9_]*$": {
      "oneOf": [
        { "$ref": "#/definitions/method_entry" },
        { "$ref": "#/definitions/category" }
      ]
    }
  },
  "definitions": {
    "method_entry": {
      "type": "object",
      "anyOf": [
        {
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "description": "Method description text with {{variables}}",
              "minLength": 10
            },
            "reference": {
              "type": "string",
              "description": "Citation for this method"
            },
            "keywords": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "_meta": {
              "$ref": "#/definitions/metadata"
            }
          }
        },
        {
          "required": ["default"],
          "properties": {
            "default": {
              "type": "string",
              "description": "Default text variant"
            },
            "large": {
              "type": "string",
              "description": "Extended text variant"
            },
            "brief": {
              "type": "string",
              "description": "Brief text variant"
            }
          }
        }
      ]
    },
    "category": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*$": {
          "oneOf": [
            { "$ref": "#/definitions/method_entry" },
            { "$ref": "#/definitions/category" }
          ]
        }
      },
      "not": {
        "required": ["text", "default"]
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created": { "type": "string", "format": "date-time" },
        "modified": { "type": "string", "format": "date-time" },
        "author": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
